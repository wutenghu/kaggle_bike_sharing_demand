# Python compiled/cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Jupyter checkpoints
.ipynb_checkpoints/

# OS/editor noise
.DS_Store
.idea/
.vscode/

# Large data files (keep directory, ignore contents)
data/*
!data/.gitkeep

# Generated artifacts
models/*
!models/.gitkeep

outputs/*
!outputs/.gitkeep

figures/*
!figures/.gitkeep

tmp/*
!tmp/.gitkeep
